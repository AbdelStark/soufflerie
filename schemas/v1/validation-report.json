{
  "$defs": {
    "BaselinePlotSeries": {
      "additionalProperties": false,
      "description": "One selected-model or baseline aggregate in the comparison plot.",
      "properties": {
        "artifact_id": {
          "pattern": "^[0-9a-f]{20}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "selected_fno",
            "mean_field",
            "nearest_design"
          ],
          "title": "Kind",
          "type": "string"
        },
        "median_cd_pct": {
          "minimum": 0.0,
          "title": "Median Cd Pct",
          "type": "number"
        },
        "median_velocity_rel_l2": {
          "minimum": 0.0,
          "title": "Median Velocity Rel L2",
          "type": "number"
        }
      },
      "required": [
        "kind",
        "artifact_id",
        "median_velocity_rel_l2",
        "median_cd_pct"
      ],
      "title": "BaselinePlotSeries",
      "type": "object"
    },
    "CasePlotPoint": {
      "additionalProperties": false,
      "description": "One test case's design, drag, and metric coordinates for report plots.",
      "properties": {
        "aspect_ratio": {
          "maximum": 1.0,
          "minimum": 0.5,
          "title": "Aspect Ratio",
          "type": "number"
        },
        "case_id": {
          "pattern": "^[0-9a-f]{20}$",
          "title": "Case Id",
          "type": "string"
        },
        "cd_field": {
          "title": "Cd Field",
          "type": "number"
        },
        "cd_field_pct": {
          "minimum": 0.0,
          "title": "Cd Field Pct",
          "type": "number"
        },
        "cd_head": {
          "title": "Cd Head",
          "type": "number"
        },
        "cd_head_pct": {
          "minimum": 0.0,
          "title": "Cd Head Pct",
          "type": "number"
        },
        "cd_solver": {
          "title": "Cd Solver",
          "type": "number"
        },
        "obstacle_ratio": {
          "minimum": 0.0,
          "title": "Obstacle Ratio",
          "type": "number"
        },
        "prediction_div_mean_abs": {
          "minimum": 0.0,
          "title": "Prediction Div Mean Abs",
          "type": "number"
        },
        "reynolds": {
          "maximum": 300.0,
          "minimum": 40.0,
          "title": "Reynolds",
          "type": "number"
        },
        "rotation_deg": {
          "maximum": 30.0,
          "minimum": 0.0,
          "title": "Rotation Deg",
          "type": "number"
        },
        "scale": {
          "maximum": 1.25,
          "minimum": 0.75,
          "title": "Scale",
          "type": "number"
        },
        "velocity_rel_l2": {
          "minimum": 0.0,
          "title": "Velocity Rel L2",
          "type": "number"
        }
      },
      "required": [
        "case_id",
        "aspect_ratio",
        "rotation_deg",
        "scale",
        "reynolds",
        "velocity_rel_l2",
        "cd_head_pct",
        "cd_field_pct",
        "prediction_div_mean_abs",
        "obstacle_ratio",
        "cd_head",
        "cd_field",
        "cd_solver"
      ],
      "title": "CasePlotPoint",
      "type": "object"
    },
    "FieldComparisonData": {
      "additionalProperties": false,
      "description": "A bounded scalar field pair for one representative or worst test case.",
      "properties": {
        "case_id": {
          "pattern": "^[0-9a-f]{20}$",
          "title": "Case Id",
          "type": "string"
        },
        "quantity": {
          "const": "velocity_magnitude",
          "default": "velocity_magnitude",
          "title": "Quantity",
          "type": "string"
        },
        "selection": {
          "enum": [
            "representative",
            "worst"
          ],
          "title": "Selection",
          "type": "string"
        },
        "solver": {
          "items": {
            "items": {
              "minimum": 0.0,
              "type": "number"
            },
            "type": "array"
          },
          "title": "Solver",
          "type": "array"
        },
        "surrogate": {
          "items": {
            "items": {
              "minimum": 0.0,
              "type": "number"
            },
            "type": "array"
          },
          "title": "Surrogate",
          "type": "array"
        },
        "units": {
          "const": "lattice_velocity",
          "default": "lattice_velocity",
          "title": "Units",
          "type": "string"
        }
      },
      "required": [
        "selection",
        "case_id",
        "solver",
        "surrogate"
      ],
      "title": "FieldComparisonData",
      "type": "object"
    },
    "GateResult": {
      "additionalProperties": false,
      "description": "One self-verifying evaluated gate; invalid numeric evidence uses false/red.",
      "properties": {
        "evidence": {
          "items": {
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "name": {
          "enum": [
            "field_error",
            "cd_head_error",
            "head_field_consistency",
            "divergence",
            "obstacle_compliance",
            "mean_baseline_field",
            "nearest_baseline_field",
            "mean_baseline_cd",
            "nearest_baseline_cd",
            "ood_variance_increase",
            "sensitivity_sign",
            "evidence_integrity"
          ],
          "title": "Name",
          "type": "string"
        },
        "operator": {
          "enum": [
            "lt",
            "le",
            "gt",
            "ge",
            "eq"
          ],
          "title": "Operator",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "status": {
          "enum": [
            "green",
            "red"
          ],
          "title": "Status",
          "type": "string"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            }
          ],
          "title": "Threshold"
        },
        "units": {
          "maxLength": 1024,
          "minLength": 1,
          "title": "Units",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "name",
        "required",
        "status",
        "value",
        "operator",
        "threshold",
        "units",
        "evidence"
      ],
      "title": "GateResult",
      "type": "object"
    },
    "MetricSummary": {
      "additionalProperties": false,
      "description": "Deterministic median/tail/bootstrap evidence without invalid-case skipping.",
      "properties": {
        "bootstrap_median_95": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "minimum": 0.0,
                  "type": "number"
                },
                {
                  "minimum": 0.0,
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Bootstrap Median 95"
        },
        "bootstrap_resamples": {
          "maximum": 100000,
          "minimum": 100,
          "title": "Bootstrap Resamples",
          "type": "integer"
        },
        "count": {
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "invalid_case_ids": {
          "items": {
            "pattern": "^[0-9a-f]{20}$",
            "type": "string"
          },
          "title": "Invalid Case Ids",
          "type": "array"
        },
        "maximum": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Maximum"
        },
        "median": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Median"
        },
        "name": {
          "enum": [
            "velocity_rel_l2",
            "cd_head_pct",
            "cd_field_pct",
            "head_field_gap_pct",
            "prediction_div_mean_abs",
            "solver_div_mean_abs",
            "obstacle_ratio"
          ],
          "title": "Name",
          "type": "string"
        },
        "p90": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "P90"
        },
        "p95": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "P95"
        },
        "report_seed": {
          "maximum": 18446744073709551615,
          "minimum": 0,
          "title": "Report Seed",
          "type": "integer"
        },
        "status": {
          "enum": [
            "valid",
            "invalid"
          ],
          "title": "Status",
          "type": "string"
        },
        "valid_count": {
          "minimum": 0,
          "title": "Valid Count",
          "type": "integer"
        },
        "worst_case_ids": {
          "items": {
            "pattern": "^[0-9a-f]{20}$",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Worst Case Ids",
          "type": "array"
        }
      },
      "required": [
        "name",
        "status",
        "count",
        "valid_count",
        "invalid_case_ids",
        "median",
        "p90",
        "p95",
        "maximum",
        "bootstrap_median_95",
        "worst_case_ids",
        "bootstrap_resamples",
        "report_seed"
      ],
      "title": "MetricSummary",
      "type": "object"
    },
    "OodEvaluation": {
      "additionalProperties": false,
      "description": "Complete 10-geometry, four-Re OOD heuristic evidence.",
      "properties": {
        "failure": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure"
        },
        "median_id_boundary_variance": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Median Id Boundary Variance"
        },
        "median_ood_variance": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Median Ood Variance"
        },
        "model_ids": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "pattern": "^[0-9a-f]{20}$",
              "type": "string"
            },
            {
              "pattern": "^[0-9a-f]{20}$",
              "type": "string"
            },
            {
              "pattern": "^[0-9a-f]{20}$",
              "type": "string"
            }
          ],
          "title": "Model Ids",
          "type": "array"
        },
        "model_sha256s": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          ],
          "title": "Model Sha256S",
          "type": "array"
        },
        "results": {
          "items": {
            "$ref": "#/$defs/OodProbeResult"
          },
          "title": "Results",
          "type": "array"
        },
        "status": {
          "enum": [
            "valid",
            "invalid"
          ],
          "title": "Status",
          "type": "string"
        },
        "variance_ratio": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Variance Ratio"
        }
      },
      "required": [
        "status",
        "model_ids",
        "model_sha256s",
        "results",
        "median_ood_variance",
        "median_id_boundary_variance",
        "variance_ratio"
      ],
      "title": "OodEvaluation",
      "type": "object"
    },
    "OodProbeResult": {
      "additionalProperties": false,
      "description": "Normalized three-model field variance for one geometry/Re probe.",
      "properties": {
        "geometry": {
          "$ref": "#/$defs/ProbeGeometry"
        },
        "model_ids": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "pattern": "^[0-9a-f]{20}$",
              "type": "string"
            },
            {
              "pattern": "^[0-9a-f]{20}$",
              "type": "string"
            },
            {
              "pattern": "^[0-9a-f]{20}$",
              "type": "string"
            }
          ],
          "title": "Model Ids",
          "type": "array"
        },
        "model_sha256s": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          ],
          "title": "Model Sha256S",
          "type": "array"
        },
        "normalized_ensemble_variance": {
          "minimum": 0.0,
          "title": "Normalized Ensemble Variance",
          "type": "number"
        },
        "regime": {
          "enum": [
            "ood",
            "id_boundary"
          ],
          "title": "Regime",
          "type": "string"
        },
        "reynolds": {
          "enum": [
            20,
            40,
            300,
            400
          ],
          "title": "Reynolds",
          "type": "integer"
        }
      },
      "required": [
        "geometry",
        "reynolds",
        "regime",
        "model_ids",
        "model_sha256s",
        "normalized_ensemble_variance"
      ],
      "title": "OodProbeResult",
      "type": "object"
    },
    "ProbeGeometry": {
      "additionalProperties": false,
      "description": "One source-bound test geometry selected by its complete rank digest.",
      "properties": {
        "aspect_ratio": {
          "maximum": 1.0,
          "minimum": 0.5,
          "title": "Aspect Ratio",
          "type": "number"
        },
        "dataset_id": {
          "pattern": "^[0-9a-f]{20}$",
          "title": "Dataset Id",
          "type": "string"
        },
        "rank_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Rank Sha256",
          "type": "string"
        },
        "rotation_deg": {
          "maximum": 30.0,
          "minimum": 0.0,
          "title": "Rotation Deg",
          "type": "number"
        },
        "scale": {
          "maximum": 1.25,
          "minimum": 0.75,
          "title": "Scale",
          "type": "number"
        },
        "selection": {
          "enum": [
            "ood",
            "sensitivity"
          ],
          "title": "Selection",
          "type": "string"
        },
        "source_case_id": {
          "pattern": "^[0-9a-f]{20}$",
          "title": "Source Case Id",
          "type": "string"
        },
        "source_design_id": {
          "pattern": "^[0-9a-f]{20}$",
          "title": "Source Design Id",
          "type": "string"
        },
        "source_reynolds": {
          "maximum": 300.0,
          "minimum": 40.0,
          "title": "Source Reynolds",
          "type": "number"
        },
        "source_split": {
          "const": "test",
          "default": "test",
          "title": "Source Split",
          "type": "string"
        }
      },
      "required": [
        "selection",
        "dataset_id",
        "source_case_id",
        "source_design_id",
        "aspect_ratio",
        "rotation_deg",
        "scale",
        "source_reynolds",
        "rank_sha256"
      ],
      "title": "ProbeGeometry",
      "type": "object"
    },
    "ProbeModelIdentity": {
      "additionalProperties": false,
      "properties": {
        "model_id": {
          "pattern": "^[0-9a-f]{20}$",
          "title": "Model Id",
          "type": "string"
        },
        "model_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Model Sha256",
          "type": "string"
        }
      },
      "required": [
        "model_id",
        "model_sha256"
      ],
      "title": "ProbeModelIdentity",
      "type": "object"
    },
    "Provenance": {
      "$comment": "Release consumers must bind source_revision, lock_sha256, config_sha256, packages, and every direct parent digest to reviewed expected values.",
      "additionalProperties": false,
      "description": "Reproducibility and direct-lineage record for a durable artifact.",
      "properties": {
        "architecture": {
          "minLength": 1,
          "title": "Architecture",
          "type": "string"
        },
        "completed_at": {
          "format": "date-time",
          "title": "Completed At",
          "type": "string"
        },
        "config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Sha256",
          "type": "string"
        },
        "deterministic": {
          "title": "Deterministic",
          "type": "boolean"
        },
        "device_class": {
          "minLength": 1,
          "title": "Device Class",
          "type": "string"
        },
        "dtype_policy": {
          "minLength": 1,
          "title": "Dtype Policy",
          "type": "string"
        },
        "gpu_seconds": {
          "minimum": 0.0,
          "title": "Gpu Seconds",
          "type": "number"
        },
        "lock_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Lock Sha256",
          "type": "string"
        },
        "os": {
          "minLength": 1,
          "title": "Os",
          "type": "string"
        },
        "packages": {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "minProperties": 1,
          "propertyNames": {
            "minLength": 1
          },
          "title": "Packages",
          "type": "object"
        },
        "parent_sha256": {
          "additionalProperties": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Parent Sha256",
          "type": "object"
        },
        "python_version": {
          "minLength": 1,
          "title": "Python Version",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "seeds": {
          "items": {
            "type": "integer"
          },
          "title": "Seeds",
          "type": "array"
        },
        "source_dirty": {
          "title": "Source Dirty",
          "type": "boolean"
        },
        "source_revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Source Revision",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        }
      },
      "required": [
        "source_revision",
        "source_dirty",
        "python_version",
        "lock_sha256",
        "packages",
        "os",
        "architecture",
        "device_class",
        "dtype_policy",
        "config_sha256",
        "seeds",
        "deterministic",
        "started_at",
        "completed_at",
        "gpu_seconds"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "SensitivityEvaluation": {
      "additionalProperties": false,
      "description": "Complete ten-case sensitivity evidence for one selected model.",
      "properties": {
        "agreement_count": {
          "maximum": 10,
          "minimum": 0,
          "title": "Agreement Count",
          "type": "integer"
        },
        "model": {
          "$ref": "#/$defs/ProbeModelIdentity"
        },
        "results": {
          "items": {
            "$ref": "#/$defs/SensitivityProbeResult"
          },
          "title": "Results",
          "type": "array"
        }
      },
      "required": [
        "model",
        "results",
        "agreement_count"
      ],
      "title": "SensitivityEvaluation",
      "type": "object"
    },
    "SensitivityProbeResult": {
      "additionalProperties": false,
      "description": "One fixed-h central difference and autograd sign comparison.",
      "properties": {
        "agrees": {
          "title": "Agrees",
          "type": "boolean"
        },
        "autograd_cd_per_degree": {
          "title": "Autograd Cd Per Degree",
          "type": "number"
        },
        "cd_center": {
          "title": "Cd Center",
          "type": "number"
        },
        "cd_minus": {
          "title": "Cd Minus",
          "type": "number"
        },
        "cd_plus": {
          "title": "Cd Plus",
          "type": "number"
        },
        "central_difference_cd_per_degree": {
          "title": "Central Difference Cd Per Degree",
          "type": "number"
        },
        "geometry": {
          "$ref": "#/$defs/ProbeGeometry"
        },
        "h_degrees": {
          "const": 0.25,
          "default": 0.25,
          "title": "H Degrees",
          "type": "number"
        },
        "magnitude_tolerance_cd_per_degree": {
          "const": 1e-05,
          "default": 1e-05,
          "title": "Magnitude Tolerance Cd Per Degree",
          "type": "number"
        },
        "model": {
          "$ref": "#/$defs/ProbeModelIdentity"
        }
      },
      "required": [
        "geometry",
        "model",
        "cd_minus",
        "cd_center",
        "cd_plus",
        "autograd_cd_per_degree",
        "central_difference_cd_per_degree",
        "agrees"
      ],
      "title": "SensitivityProbeResult",
      "type": "object"
    },
    "ValidationPlotData": {
      "additionalProperties": false,
      "description": "Complete bounded inputs for the RFC-0008 deterministic plot set.",
      "properties": {
        "baselines": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "$ref": "#/$defs/BaselinePlotSeries"
            },
            {
              "$ref": "#/$defs/BaselinePlotSeries"
            },
            {
              "$ref": "#/$defs/BaselinePlotSeries"
            }
          ],
          "title": "Baselines",
          "type": "array"
        },
        "cases": {
          "items": {
            "$ref": "#/$defs/CasePlotPoint"
          },
          "maxItems": 10000,
          "minItems": 3,
          "title": "Cases",
          "type": "array"
        },
        "representative_fields": {
          "$ref": "#/$defs/FieldComparisonData"
        },
