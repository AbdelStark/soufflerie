{
  "$defs": {
    "CompatibilityRange": {
      "additionalProperties": false,
      "description": "Closed runtime range for the v0.1 FNO bundle format.",
      "properties": {
        "maximum_bundle_schema": {
          "const": 1,
          "default": 1,
          "title": "Maximum Bundle Schema",
          "type": "integer"
        },
        "maximum_python_exclusive": {
          "default": [
            3,
            12
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Maximum Python Exclusive",
          "type": "array"
        },
        "maximum_soufflerie_exclusive": {
          "default": "0.2.0",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
          "title": "Maximum Soufflerie Exclusive",
          "type": "string"
        },
        "minimum_bundle_schema": {
          "const": 1,
          "default": 1,
          "title": "Minimum Bundle Schema",
          "type": "integer"
        },
        "minimum_python": {
          "default": [
            3,
            11
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Minimum Python",
          "type": "array"
        },
        "minimum_soufflerie": {
          "default": "0.1.0",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
          "title": "Minimum Soufflerie",
          "type": "string"
        },
        "physicsnemo": {
          "const": "2.2.1",
          "default": "2.2.1",
          "title": "Physicsnemo",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "torch": {
          "const": "2.10.0",
          "default": "2.10.0",
          "title": "Torch",
          "type": "string"
        }
      },
      "title": "CompatibilityRange",
      "type": "object"
    },
    "ModelCardGate": {
      "additionalProperties": false,
      "description": "One required validation gate rendered without recomputation.",
      "properties": {
        "evidence_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Sha256"
        },
        "measured": {
          "anyOf": [
            {
              "pattern": "^[^\\r\\n|]{1,240}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Measured"
        },
        "name": {
          "pattern": "^[^\\r\\n|]{1,240}$",
          "title": "Name",
          "type": "string"
        },
        "status": {
          "enum": [
            "not_evaluated",
            "green",
            "red"
          ],
          "title": "Status",
          "type": "string"
        },
        "threshold": {
          "pattern": "^[^\\r\\n|]{1,240}$",
          "title": "Threshold",
          "type": "string"
        }
      },
      "required": [
        "name",
        "status",
        "threshold"
      ],
      "title": "ModelCardGate",
      "type": "object"
    },
    "ModelCardMetadata": {
      "additionalProperties": false,
      "description": "Bounded factual content rendered into the immutable model card.",
      "properties": {
        "display_name": {
          "pattern": "^[^\\r\\n|]{1,240}$",
          "title": "Display Name",
          "type": "string"
        },
        "gates": {
          "items": {
            "$ref": "#/$defs/ModelCardGate"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Gates",
          "type": "array"
        },
        "intended_uses": {
          "items": {
            "pattern": "^[^\\r\\n|]{1,240}$",
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Intended Uses",
          "type": "array"
        },
        "license": {
          "const": "Apache-2.0",
          "default": "Apache-2.0",
          "title": "License",
          "type": "string"
        },
        "limitations": {
          "items": {
            "pattern": "^[^\\r\\n|]{1,240}$",
            "type": "string"
          },
          "maxItems": 12,
          "minItems": 1,
          "title": "Limitations",
          "type": "array"
        },
        "summary": {
          "pattern": "^[^\\r\\n|]{1,240}$",
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "display_name",
        "summary",
        "intended_uses",
        "limitations",
        "gates"
      ],
      "title": "ModelCardMetadata",
      "type": "object"
    },
    "ModelTensorDescriptor": {
      "additionalProperties": false,
      "description": "One exact float32 state tensor and its pre-allocation byte count.",
      "properties": {
        "dtype": {
          "const": "float32",
          "default": "float32",
          "title": "Dtype",
          "type": "string"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_.]{0,127}$",
          "title": "Name",
          "type": "string"
        },
        "nbytes": {
          "maximum": 25165824,
          "minimum": 1,
          "title": "Nbytes",
          "type": "integer"
        },
        "shape": {
          "items": {
            "type": "integer"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Shape",
          "type": "array"
        }
      },
      "required": [
        "name",
        "shape",
        "nbytes"
      ],
      "title": "ModelTensorDescriptor",
      "type": "object"
    }
  },
