# Optional non-secret Modal environment selector. Authentication stays in the
# local Modal profile or provider-managed CI environment.
MODAL_ENVIRONMENT=main

# L40S is the reference class. A10G is an explicit functional fallback and does
# not inherit L40S performance claims.
SOUFFLERIE_REMOTE_GPU=L40S

# Public solve stays fail-closed in the checked local example. A deployment may
# enable it only alongside a positive reviewed service budget and remote adapter.
SOUFFLERIE_SOLVE_ENABLED=false
SOUFFLERIE_SOLVE_GPU_SECONDS_PER_DAY=0

# Public deployments inject SOUFFLERIE_CLIENT_HMAC_KEY as a provider-managed
# secret containing exactly 64 lowercase hexadecimal characters. When absent,
# a process-local ephemeral key is generated; the raw key is never telemetry.

# Comma-separated IP/CIDR allowlist for immediate reverse proxies. Empty means
# X-Forwarded-For is ignored, which is the safe direct-client default.
SOUFFLERIE_TRUSTED_PROXIES=
